<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:gravity="center_horizontal"
	android:orientation="vertical">

	<LinearLayout
		android:id="@+id/reviewContainer"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="center_horizontal"
		android:layout_marginBottom="@dimen/list_spacing_large"
		android:maxWidth="@dimen/reviews_content_max_width"
		android:orientation="horizontal"
		android:paddingStart="@dimen/list_spacing_large"
		android:paddingTop="@dimen/list_spacing_small"
		android:paddingEnd="@dimen/list_spacing_large"
		android:paddingBottom="@dimen/list_spacing_small">

		<org.koitharu.kotatsu.core.image.CoilImageView
			android:id="@+id/imageAvatar"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:contentDescription="@string/reviews_title"
			android:layout_gravity="center_vertical"
			app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Kotatsu.Circle"
			app:strokeWidth="0dp"
			tools:src="@tools:sample/avatars" />

		<LinearLayout
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_vertical"
			android:layout_marginStart="@dimen/list_spacing_large"
			android:orientation="vertical">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<com.google.android.material.textview.MaterialTextView
					android:id="@+id/textName"
					style="?attr/textAppearanceTitleSmall"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:ellipsize="end"
					android:maxLines="1"
					android:textColor="?attr/colorOnSurface"
					android:textStyle="bold"
					tools:text="Sakura" />

				<com.google.android.material.textview.MaterialTextView
					android:id="@+id/textTimestamp"
					style="?attr/textAppearanceBodySmall"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textColor="?attr/colorOnSurfaceVariant"
					tools:text="5m ago" />

			</LinearLayout>

			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardBubble"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/list_spacing_small"
				android:layout_marginBottom="@dimen/list_spacing_small"
				app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
				app:cardCornerRadius="@dimen/m3_card_corner"
				app:cardElevation="0dp"
				app:strokeWidth="0dp">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:paddingStart="@dimen/list_spacing_large"
					android:paddingTop="@dimen/list_spacing_large"
					android:paddingEnd="@dimen/list_spacing_large"
					android:paddingBottom="@dimen/list_spacing_large">

					<com.google.android.material.textview.MaterialTextView
						android:id="@+id/textSummary"
						style="?attr/textAppearanceBodyLarge"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:textColor="?attr/colorOnSurface"
						android:textStyle="bold"
						tools:text="Fantastic pacing and art" />

					<com.google.android.material.textview.MaterialTextView
						android:id="@+id/textBody"
						style="?attr/textAppearanceBodyMedium"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="@dimen/list_spacing_small"
						android:autoLink="web"
						android:linksClickable="true"
						android:textColor="?attr/colorOnSurfaceVariant"
						tools:text="Markdown content rendered as HTML goes here." />

				</LinearLayout>

			</com.google.android.material.card.MaterialCardView>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="start"
				android:orientation="horizontal">

				<com.google.android.material.textview.MaterialTextView
					android:id="@+id/textScore"
					style="?attr/textAppearanceLabelMedium"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:drawablePadding="@dimen/list_spacing_small"
					android:drawableStart="@drawable/ic_star_small"
					android:textColor="?attr/colorOnSurface"
					tools:text="80/100" />

				<com.google.android.material.textview.MaterialTextView
					android:id="@+id/textRating"
					style="?attr/textAppearanceLabelMedium"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginStart="@dimen/list_spacing_large"
					android:drawablePadding="@dimen/list_spacing_small"
					android:drawableStart="@drawable/ic_heart_outline"
					android:textColor="?attr/colorOnSurfaceVariant"
					tools:text="42" />

			</LinearLayout>

		</LinearLayout>

	</LinearLayout>

</LinearLayout>
